{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Valet",
  "version": "0.1.12",
  "identifier": "in.davidsling.valet",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Valet",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["valet"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdEQ0IxNEUyOTM5NjEzRDAKUldUUUU1YVQ0aFRMZlp4bEJqc2JobTNVSVBPeHlIMEt4RmROS1VtRTQrN0kwZmUwUTgwSWRYYmcK",
      "endpoints": [
        "https://github.com/david-sling/valet/releases/latest/download/latest.json"
      ]
    }
  }
}
