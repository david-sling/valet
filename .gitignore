.DS_Store

# Impeccable engine binary: the launcher downloads it on first run
/.claude/skills/impeccable/scripts/bin/

# Impeccable review captures and local config
/.impeccable/review/
/.impeccable/config.local.json
/.impeccable/hook.cache.json

# Per-machine agent permissions and hooks
.claude/settings.local.json

# Dependencies and build output, across the workspace
node_modules
target

# Claude Code writes the plugin API types here when it loads the mod
plugins/*/.claude-plugin/types/
